NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_DOCTOR_NAME=Dr. Nombre Apellido
NEXT_PUBLIC_DOCTOR_EMAIL=doctor@example.com
NEXT_PUBLIC_DOCTOR_PHONE=+51 999 999 999

# Only used by server-side jobs if needed. Never expose this as NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: absolute path to a local Tesseract language directory containing eng.traineddata.gz.
# Defaults to node_modules/@tesseract.js-data/eng/4.0.0.
TESSERACT_LANG_PATH=
